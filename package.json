{
  "name": "@vibecontrols/vibe-plugin-storage-postgres",
  "version": "2026.509.4",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "description": "PostgreSQL storage provider for the VibeControls agent — full-parity adapter with AES-256-GCM encryption at rest.",
  "engines": {
    "bun": ">=1.4.4"
  },
  "author": {
    "name": "Vignesh T.V",
    "url": "https://github.com/tvvignesh"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify-syntax --minify-whitespace --external elysia && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "type:check": "boff gate -- bun check --no-pretty",
    "test": "bun test",
    "clean": "rimraf dist",
    "prebuild": "bun run clean",
    "prepublishOnly": "bun run build",
    "sanity": "boff sanity",
    "sanity:force": "boff sanity --force",
    "audit": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@vibecontrols/plugin-sdk": "2026.1108.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@burdenoff/toolchain": "2026.1107.14",
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "knip": "^6.44.1",
    "rimraf": "^6.1.4",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@vibecontrols/vibe-plugin-storage": "2026.509.2",
    "@vibecontrols/agent": ">=2026.428.0"
  },
  "peerDependenciesMeta": {
    "@vibecontrols/agent": {
      "optional": true
    }
  },
  "files": [
    "!dist/**/*.map",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "vibecontrols",
    "vibecontrols-agent",
    "vibe-plugin",
    "storage",
    "postgres",
    "postgresql",
    "encryption"
  ],
  "homepage": "https://github.com/Algoshred/vibe-plugin-storage-postgres",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Algoshred/vibe-plugin-storage-postgres.git"
  },
  "bugs": {
    "url": "https://github.com/Algoshred/vibe-plugin-storage-postgres/issues"
  },
  "packageManager": "bun@1.4.4",
  "boff": {
    "type": "plugin",
    "sanity": {
      "steps": [
        "format",
        "lint",
        "typecheck",
        "build",
        "test",
        "knip"
      ]
    }
  }
}
